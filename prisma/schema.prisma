// Kavya Financial Services — Prisma schema
// learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Auth / staff
// ---------------------------------------------------------------------------

enum UserRole {
  ADMIN
  EMPLOYEE
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  role         UserRole  @default(EMPLOYEE)
  active       Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  assignedLeads Lead[]     @relation("AssignedLeads")
  leadNotes     LeadNote[]

  @@map("users")
}

// ---------------------------------------------------------------------------
// Leads / CRM
// ---------------------------------------------------------------------------

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  IN_PROGRESS
  CONVERTED
  LOST
}

model Lead {
  id       String     @id @default(cuid())
  name     String
  phone    String
  email    String?
  city     String?
  interest String
  message  String?
  source   String?
  status   LeadStatus @default(NEW)
  ip       String?

  assignedTo   User?   @relation("AssignedLeads", fields: [assignedToId], references: [id])
  assignedToId String?

  notes     LeadNote[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([status])
  @@index([createdAt])
  @@map("leads")
}

model LeadNote {
  id        String   @id @default(cuid())
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  leadId    String
  author    User?    @relation(fields: [authorId], references: [id])
  authorId  String?
  body      String
  createdAt DateTime @default(now())

  @@map("lead_notes")
}

// ---------------------------------------------------------------------------
// Content status (shared by content models)
// ---------------------------------------------------------------------------

enum ContentStatus {
  DRAFT
  PUBLISHED
}

// ---------------------------------------------------------------------------
// Loan products
// ---------------------------------------------------------------------------

enum LoanCategory {
  SECURED
  UNSECURED
}

model LoanProduct {
  id             String        @id @default(cuid())
  slug           String        @unique
  name           String
  shortName      String
  category       LoanCategory
  tagline        String
  description    String
  icon           String
  interestRate   String
  maxAmount      String
  maxTenure      String
  processingTime String
  processingFee  String
  benefits       String[]
  eligibility    String[]
  documents      String[]
  faqs           Json
  status         ContentStatus @default(PUBLISHED)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@map("loan_products")
}

// ---------------------------------------------------------------------------
// Real estate
// ---------------------------------------------------------------------------

model Property {
  id                String        @id @default(cuid())
  slug              String        @unique
  title             String
  type              String
  typeLabel         String
  price             Int
  priceLabel        String
  location          String
  city              String
  state             String
  areaSqft          Int
  bedrooms          Int?
  bathrooms         Int?
  bankLoanAvailable Boolean       @default(false)
  featured          Boolean       @default(false)
  images            String[]
  description       String
  amenities         String[]
  nearbyPlaces      Json
  lat               Float
  lng               Float
  reraId            String?
  status            ContentStatus @default(PUBLISHED)
  postedOn          DateTime      @default(now())
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@map("properties")
}

model AuctionProperty {
  id                String        @id @default(cuid())
  title             String
  bank              String
  location          String
  city              String
  state             String
  reservePrice      Int
  reservePriceLabel String
  emdAmount         String
  auctionDate       DateTime
  propertyType      String
  areaSqft          Int
  image             String
  description       String
  status            ContentStatus @default(PUBLISHED)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@map("auction_properties")
}

// ---------------------------------------------------------------------------
// Tax / compliance services
// ---------------------------------------------------------------------------

model TaxService {
  id          String        @id @default(cuid())
  slug        String        @unique
  name        String
  tagline     String
  description String
  icon        String
  price       String
  timeline    String
  benefits    String[]
  process     Json
  documents   String[]
  faqs        Json
  status      ContentStatus @default(PUBLISHED)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@map("tax_services")
}

// ---------------------------------------------------------------------------
// Blog
// ---------------------------------------------------------------------------

model BlogPost {
  id          String        @id @default(cuid())
  slug        String        @unique
  title       String
  excerpt     String
  content     String[]
  category    String
  tags        String[]
  author      String
  authorRole  String
  publishedOn DateTime      @default(now())
  readMinutes Int           @default(5)
  image       String
  status      ContentStatus @default(PUBLISHED)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@map("blog_posts")
}

// ---------------------------------------------------------------------------
// Testimonials / FAQs / Partner banks
// ---------------------------------------------------------------------------

enum TestimonialStatus {
  PENDING
  APPROVED
  REJECTED
}

model Testimonial {
  id        String            @id @default(cuid())
  name      String
  location  String
  rating    Int
  service   String
  quote     String
  avatar    String
  status    TestimonialStatus @default(APPROVED)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@map("testimonials")
}

model Faq {
  id        String   @id @default(cuid())
  question  String
  answer    String
  category  String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("faqs")
}

model PartnerBank {
  id        String   @id @default(cuid())
  name      String
  shortName String
  type      String
  order     Int      @default(0)
  createdAt DateTime @default(now())

  @@map("partner_banks")
}

// ---------------------------------------------------------------------------
// Audit log (admin actions)
// ---------------------------------------------------------------------------

model AuditLog {
  id         String   @id @default(cuid())
  actorEmail String
  action     String
  entity     String
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([entity, entityId])
  @@map("audit_logs")
}
